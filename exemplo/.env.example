# Copie para .env (ignorado pelo git) e preencha.

# Conta de teste usada pelos exemplos de login.
E2E_USER_DEMO_USERNAME=
E2E_USER_DEMO_PASSWORD=

# Mobile: o bundle id (iOS) ou package (Android) do seu app.
# Sem ele, só o alvo web existe.
# APP_BUNDLE_ID=com.exemplo.app

# Simulador iOS pelo nome de `npx agent-device devices` (padrão iPhone 17).
# IOS_SIMULATOR=
